<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Inkwell's engine: the document model (close to WordprocessingML), the style engine, .docx reading and writing
    with preservation of everything it doesn't understand, the layout engine (WPF TextFormatter: line breaking,
    shaping, bidi; pagination), page rendering, editing with undo, and the import / export formats.
    No windows here, so the tests use it directly. Same two targets as the app.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Inkwell.Core</RootNamespace>
    <AssemblyName>Inkwell.Core</AssemblyName>
    <Version>1.0.1</Version>
    <Product>Inkwell</Product>
    <Company>Inkwell</Company>
    <Copyright>Copyright © 2026 Muhammad Noman</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Net.Http" />
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <!-- MIT licence: .docx packages (parts, relationships, content types) -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <!-- MIT licence: PDF export -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <!-- MIT licence: PDFsharp needs it; 10.0.13 has the security fixes the version it would bring lacks (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- BSD-2-Clause licence: Markdown import -->
    <PackageReference Include="Markdig" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <ItemGroup>
    <!-- The bundled SIL OFL fonts, loaded privately from <app>\Fonts (never installed). tools\get-fonts.ps1 refreshes them. -->
    <None Include="Fonts\*.ttf;Fonts\*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
