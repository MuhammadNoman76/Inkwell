<UserControl x:Class="Inkwell.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Inkwell.Controls"
             xmlns:e="clr-namespace:Inkwell.Views.Editing"
             Focusable="False">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================ command bar -->
        <Grid x:Name="CommandBar" Height="50" Margin="8,2,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- app menu + document name -->
            <StackPanel x:Name="BarLeft" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="MenuButton" Style="{StaticResource SubtleButton}" Padding="6,4" ToolTip="Menu (Alt+F)"
                        AutomationProperties.Name="Menu" Click="OnMenu">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="22" Height="22" Source="{StaticResource Logo.Mark}" />
                        <c:IconView Width="10" Height="10" Margin="6,1,0,0" Data="{StaticResource Icon.ChevronDown}" Foreground="{DynamicResource Text.Secondary}" />
                    </StackPanel>
                </Button>
                <StackPanel x:Name="DocNamePanel" Margin="8,0,0,0" VerticalAlignment="Center" MaxWidth="190">
                    <TextBlock x:Name="DocName" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text.Primary}" />
                    <TextBlock x:Name="SaveState" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <!-- undo / redo -->
            <StackPanel x:Name="BarUndo" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <Button x:Name="UndoButton" Style="{StaticResource IconButton}" c:Ui.Icon="{StaticResource Icon.ArrowUndo}" ToolTip="Undo (Ctrl+Z)"
                        AutomationProperties.Name="Undo" Click="OnUndo" />
                <Button x:Name="RedoButton" Style="{StaticResource IconButton}" c:Ui.Icon="{StaticResource Icon.ArrowRedo}" ToolTip="Redo (Ctrl+Y)"
                        AutomationProperties.Name="Redo" Click="OnRedo" />
                <Border Width="1" Height="22" Margin="8,0,6,0" Background="{DynamicResource Divider}" />
            </StackPanel>

            <!-- formatting and insert (scrolls sideways when the window is narrow) -->
            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False" x:Name="BarScroller">
                <StackPanel x:Name="FormatBar" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StyleButton" Style="{StaticResource SubtleButton}" Height="32" MinWidth="118" Padding="10,0,8,0" Click="OnStyleMenu"
                            ToolTip="Paragraph style" AutomationProperties.Name="Paragraph style">
                        <DockPanel LastChildFill="True">
                            <c:IconView DockPanel.Dock="Right" Width="10" Height="10" Margin="8,1,0,0" Data="{StaticResource Icon.ChevronDown}" Foreground="{DynamicResource Text.Secondary}" />
                            <TextBlock x:Name="StyleName" Text="Body" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="110" />
                        </DockPanel>
                    </Button>
                    <Button x:Name="FontButton" Style="{StaticResource SubtleButton}" Height="32" MinWidth="120" Padding="10,0,8,0" Margin="2,0,0,0" Click="OnFontMenu"
                            ToolTip="Font" AutomationProperties.Name="Font">
                        <DockPanel>
                            <c:IconView DockPanel.Dock="Right" Width="10" Height="10" Margin="8,1,0,0" Data="{StaticResource Icon.ChevronDown}" Foreground="{DynamicResource Text.Secondary}" />
                            <TextBlock x:Name="FontName" Text="Literata" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="120" />
                        </DockPanel>
                    </Button>
                    <c:NumberBox x:Name="SizeBox" Width="58" MinWidth="50" Height="30" Margin="2,0,0,0" Minimum="1" Maximum="1638" Step="1" Decimals="1"
                                 AutomationProperties.Name="Font size" ToolTip="Font size (Ctrl+] / Ctrl+[)" />
                    <Border Width="1" Height="22" Margin="8,0,6,0" Background="{DynamicResource Divider}" />
                    <ToggleButton x:Name="BoldToggle" Style="{StaticResource IconToggle}" c:Ui.Icon="{StaticResource Icon.TextBold}" ToolTip="Bold (Ctrl+B)" AutomationProperties.Name="Bold" Click="OnBold" />
                    <ToggleButton x:Name="ItalicToggle" Style="{StaticResource IconToggle}" c:Ui.Icon="{StaticResource Icon.TextItalic}" ToolTip="Italic (Ctrl+I)" AutomationProperties.Name="Italic" Click="OnItalic" />
                    <ToggleButton x:Name="UnderlineToggle" Style="{StaticResource IconToggle}" c:Ui.Icon="{StaticResource Icon.TextUnderline}" ToolTip="Underline (Ctrl+U)" AutomationProperties.Name="Underline" Click="OnUnderline" />
                    <Button x:Name="ColorButton" Style="{StaticResource IconButton}" c:Ui.Icon="{StaticResource Icon.TextColor}" ToolTip="Text colour and highlight" AutomationProperties.Name="Text colour and highlight" Click="OnColorMenu" />
                    <Button Style="{StaticResource IconButton}" c:Ui.Icon="{StaticResource Icon.MoreHorizontal}" ToolTip="More text formatting" AutomationProperties.Name="More text formatting" Click="OnMoreFormatMenu" />
                    <Border Width="1" Height="22" Margin="6,0,6,0" Background="{DynamicResource Divider}" />
                    <ToggleButton x:Name="BulletsToggle" Style="{StaticResource IconToggle}" c:Ui.Icon="{StaticResource Icon.TextBulletListLtr}" ToolTip="Bullets (Ctrl+Shift+L)" AutomationProperties.Name="Bullets" Click="OnBullets" />
                    <ToggleButton x:Name="NumbersToggle" Style="{StaticResource IconToggle}" c:Ui.Icon="{StaticResource Icon.TextNumberListLtr}" ToolTip="Numbering" AutomationProperties.Name="Numbering" Click="OnNumbers" />
                    <Button x:Name="AlignButton" Style="{StaticResource IconButton}" c:Ui.Icon="{StaticResource Icon.TextAlignLeft}" ToolTip="Alignment and direction" AutomationProperties.Name="Alignment and direction" Click="OnAlignMenu" />
                    <Border Width="1" Height="22" Margin="6,0,4,0" Background="{DynamicResource Divider}" />
                    <StackPanel x:Name="QuickInsert" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" c:Ui.Icon="{StaticResource Icon.ImageAdd}" ToolTip="Insert a picture (or paste / drop one)" AutomationProperties.Name="Insert picture" Click="OnInsertPicture" />
                    <Button Style="{StaticResource IconButton}" c:Ui.Icon="{StaticResource Icon.Table}" ToolTip="Insert a table" AutomationProperties.Name="Insert table" Click="OnInsertTable" />
                    <Button Style="{StaticResource IconButton}" c:Ui.Icon="{StaticResource Icon.Link}" ToolTip="Insert a link (Ctrl+Shift+K)" AutomationProperties.Name="Insert link" Click="OnInsertLink" />
                    <Button Style="{StaticResource IconButton}" c:Ui.Icon="{StaticResource Icon.CommentAdd}" ToolTip="Add a comment (Ctrl+Alt+M)" AutomationProperties.Name="Add comment" Click="OnInsertComment" />
                    </StackPanel>
                    <Button Style="{StaticResource CommandButton}" c:Ui.Icon="{StaticResource Icon.Add}" Content="Insert" ToolTip="More things to insert" AutomationProperties.Name="Insert more" Click="OnInsertMenu" />
                </StackPanel>
            </ScrollViewer>

            <!-- right side -->
            <StackPanel x:Name="BarRight" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <Button x:Name="PaletteButton" Style="{StaticResource PaletteButton}" Width="176" Margin="0,0,8,0" Content="Search commands"
                        AutomationProperties.Name="Command palette" ToolTip="Find any command, style, template or heading (Ctrl+K)" Click="OnPalette" />
                <ToggleButton x:Name="ReviewToggle" Style="{StaticResource IconToggle}" c:Ui.Icon="{StaticResource Icon.TrackChanges}" ToolTip="Review: track changes and comments" AutomationProperties.Name="Review" Click="OnReviewToggle" />
                <ToggleButton x:Name="PanelToggle" Style="{StaticResource IconToggle}" c:Ui.Icon="{StaticResource Icon.PanelRight}" ToolTip="Show or hide the panel (Ctrl+F1)" AutomationProperties.Name="Panel" Click="OnPanelToggle" Margin="0,0,6,0" />
                <Button x:Name="ShareButton" Style="{StaticResource AccentCommandButton}" c:Ui.Icon="{StaticResource Icon.Share}" Content="Export"
                        ToolTip="Export as PDF, Markdown, HTML or text, or print" AutomationProperties.Name="Export" Click="OnExport" />
            </StackPanel>
        </Grid>

        <!-- ============================================================ work area -->
        <Grid x:Name="WorkArea" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OutlineColumn" Width="236" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="PanelColumn" Width="332" />
            </Grid.ColumnDefinitions>

            <Border x:Name="OutlineHost" Grid.Column="0" />

            <Border x:Name="CenterLayer" Grid.Column="1" CornerRadius="8,8,0,0" BorderThickness="1,1,1,0"
                    Background="{DynamicResource Canvas.Background}" BorderBrush="{DynamicResource Layer.Stroke}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="Scroller" CanContentScroll="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <e:DocumentView x:Name="Doc" />
                    </ScrollViewer>
                    <!-- chips (paste options, autocorrect) and the slash menu sit on top of the page -->
                    <Canvas x:Name="ChipLayer" />
                    <Border x:Name="FindHost" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,26,0" />

                    <!-- status bar -->
                    <Border x:Name="StatusBar" Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Divider}" Background="{DynamicResource Layer.Background}" Padding="10,0,8,0" Height="32">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource SegmentTray}" Margin="0,0,4,0" Padding="0">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ViewPages" Style="{StaticResource IconSegment}" Width="28" Height="24" c:Ui.Icon="{StaticResource Icon.DocumentOnePage}" IsChecked="True"
                                                     ToolTip="Page view" AutomationProperties.Name="Page view" GroupName="View" Checked="OnViewModeChanged" />
                                        <RadioButton x:Name="ViewPageless" Style="{StaticResource IconSegment}" Width="28" Height="24" c:Ui.Icon="{StaticResource Icon.DocumentText}"
                                                     ToolTip="Pageless view: continuous text for drafting" AutomationProperties.Name="Pageless view" GroupName="View" Checked="OnViewModeChanged" />
                                    </StackPanel>
                                </Border>
                                <ToggleButton x:Name="FocusToggle" Style="{StaticResource IconToggle}" Width="28" Height="26" c:Ui.Icon="{StaticResource Icon.Focus}" ToolTip="Focus mode (F11)"
                                              AutomationProperties.Name="Focus mode" Click="OnFocusToggle" Margin="0,0,6,0" />
                                <Border Width="1" Height="16" Margin="0,0,6,0" Background="{DynamicResource Divider}" />
                                <Button Style="{StaticResource IconButton}" Width="26" Height="26" c:Ui.Icon="{StaticResource Icon.DocumentMultiple}" ToolTip="Several pages side by side"
                                        AutomationProperties.Name="Multiple pages" Click="OnMultiplePages" />
                                <Button Style="{StaticResource IconButton}" Width="26" Height="26" c:Ui.Icon="{StaticResource Icon.PageFit}" ToolTip="Fit the page width (Ctrl+0)"
                                        AutomationProperties.Name="Fit page width" Click="OnZoomFit" />
                                <Button Style="{StaticResource IconButton}" Width="26" Height="26" c:Ui.Icon="{StaticResource Icon.ZoomOut}" ToolTip="Zoom out (Ctrl+-)"
                                        AutomationProperties.Name="Zoom out" Click="OnZoomOut" />
                                <Slider x:Name="ZoomSlider" Width="96" Minimum="25" Maximum="300" Value="100" VerticalAlignment="Center" Margin="2,0"
                                        AutomationProperties.Name="Zoom" ValueChanged="OnZoomSlider" />
                                <Button Style="{StaticResource IconButton}" Width="26" Height="26" c:Ui.Icon="{StaticResource Icon.ZoomIn}" ToolTip="Zoom in (Ctrl++)"
                                        AutomationProperties.Name="Zoom in" Click="OnZoomIn" />
                                <Button x:Name="ZoomText" Style="{StaticResource SubtleButton}" MinWidth="48" Height="26" Padding="4,0" FontSize="12" ToolTip="Zoom to 100 %"
                                        AutomationProperties.Name="Zoom level, click for 100 percent" Click="OnZoom100" />
                            </StackPanel>
                            <StackPanel x:Name="StatusLeft" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="PageStatus" FontSize="12" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                <Button x:Name="WordStatus" Style="{StaticResource SubtleButton}" Height="26" Padding="6,0" FontSize="12" Click="OnWordCount"
                                        ToolTip="Words, characters and reading time" AutomationProperties.Name="Word count" />
                                <Grid x:Name="GoalRing" Width="18" Height="18" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="Word goal">
                                    <Ellipse Stroke="{DynamicResource Control.StrokeSecondary}" StrokeThickness="2.5" />
                                    <Path x:Name="GoalArc" Stroke="{DynamicResource Accent.Fill}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Grid>
                                <TextBlock x:Name="GoalText" FontSize="12" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed" />
                                <Button x:Name="TrackStatus" Style="{StaticResource SubtleButton}" Height="26" Padding="6,0" FontSize="12" Margin="10,0,0,0" Visibility="Collapsed"
                                        Content="Tracking changes" Foreground="{DynamicResource Status.Caution}" Click="OnReviewToggle" AutomationProperties.Name="Track changes is on" />
                                <TextBlock x:Name="LanguageStatus" FontSize="12" Foreground="{DynamicResource Text.Tertiary}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="PanelHost" Grid.Column="2" />
        </Grid>

        <!-- command palette and other overlays -->
        <Grid x:Name="OverlayLayer" Grid.RowSpan="2" />
    </Grid>
</UserControl>
