<UserControl x:Class="Inkwell.Views.StartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Inkwell.Controls"
             Focusable="False">
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel x:Name="Root" Margin="56,30,56,48" MaxWidth="1320">
            <!-- header -->
            <DockPanel Margin="0,0,0,26">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource IconButton}" c:Ui.Icon="{StaticResource Icon.Info}" ToolTip="About Inkwell"
                            AutomationProperties.Name="About Inkwell" Click="OnAbout" />
                    <Button Margin="4,0,0,0" Style="{StaticResource IconButton}" c:Ui.Icon="{StaticResource Icon.Settings}" ToolTip="Settings (Ctrl+,)"
                            AutomationProperties.Name="Settings" Click="OnSettings" />
                </StackPanel>
                <Image DockPanel.Dock="Left" Width="52" Height="52" Margin="0,0,16,0" Source="{StaticResource Logo.Mark}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.Title}" Text="Inkwell" FontSize="30" />
                    <TextBlock Style="{StaticResource Text.BodySecondary}" Margin="1,2,0,0" Text="Write beautifully. Without fighting your document." />
                </StackPanel>
            </DockPanel>

            <!-- recovered work -->
            <StackPanel x:Name="RecoveryPanel" Visibility="Collapsed" Margin="0,0,0,24" />

            <!-- new -->
            <DockPanel Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource IconTextButton}" c:Ui.Icon="{StaticResource Icon.FolderOpen}" Content="Open…" Click="OnOpen"
                            ToolTip="Open a Word document, Markdown, text, RTF or OpenDocument file (Ctrl+O)" />
                </StackPanel>
                <TextBlock Style="{StaticResource Text.Subtitle}" Text="Start writing" VerticalAlignment="Center" />
            </DockPanel>
            <ItemsControl x:Name="TemplateCards" Focusable="False" Margin="-8,0,-8,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <c:CardGrid MinItemWidth="172" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- recent -->
            <TextBlock Style="{StaticResource Text.Subtitle}" Text="Recent" Margin="0,30,0,12" />
            <TextBlock x:Name="NoRecent" Style="{StaticResource Text.BodySecondary}" Visibility="Collapsed"
                       Text="Documents you open or save appear here." />
            <ItemsControl x:Name="RecentCards" Focusable="False" Margin="-8,0,-8,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <c:CardGrid MinItemWidth="172" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- what Inkwell fixes -->
            <DockPanel x:Name="TourHeader" Margin="0,34,0,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Content="Hide" Click="OnHideTour" ToolTip="Hide this section"
                        AutomationProperties.Name="Hide what Inkwell fixes" />
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Subtitle}" Text="What Inkwell fixes" />
                    <TextBlock Style="{StaticResource Text.BodySecondary}" Margin="0,2,0,0"
                               Text="The things that make word processors frustrating, handled properly." />
                </StackPanel>
            </DockPanel>
            <ItemsControl x:Name="TourCards" Focusable="False" Margin="-6,0,-6,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <c:CardGrid MinItemWidth="300" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
