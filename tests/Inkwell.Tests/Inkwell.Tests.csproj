<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for the engine (Inkwell.Core) and checks of the app (shortcuts, updater, settings), on both targets: .NET 10 and .NET Framework 4.8. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Inkwell.Tests</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Net.Http" />
    <Using Include="Xunit" />
    <Using Include="Xunit.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.IO.Compression" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Inkwell.Core\Inkwell.Core.csproj" />
    <ProjectReference Include="..\..\src\Inkwell\Inkwell.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Small test files (generated pictures, documents saved by Word for fidelity checks). -->
    <None Include="Files\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
